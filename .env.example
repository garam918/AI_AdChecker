# 식품안전나라 데이터활용서비스(I0030)에서 발급받은 서버 전용 인증키
FOOD_SAFETY_KOREA_API_KEY=

# 공공데이터포털(data.go.kr)에서 발급받은 서버 전용 서비스키
DATA_GO_KR_SERVICE_KEY=

# 활용신청한 API의 상세기능 요청 URL을 입력합니다. API 개편에 대응할 수 있도록
# 코드에 고정하지 않으며, 브라우저에 노출되지 않는 서버 환경변수로만 사용합니다.
MFDS_DRUG_PRODUCT_API_URL=
MFDS_MEDICAL_DEVICE_PRODUCT_API_URL=
MFDS_COSMETIC_PRODUCT_API_URL=

# RAG: 기본값 none은 외부 호출 없는 BM25 검색입니다.
# openai 또는 ollama로 바꾼 뒤 npm run rag:index -- --embed를 실행합니다.
RAG_EMBEDDING_PROVIDER=none
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_DIMENSIONS=

# openai 임베딩: 미지정 시 text-embedding-3-small / 1536 차원.
# 같은 키가 AI 분석 대체 제공자(OpenAI Responses API)에도 사용됩니다.
OPENAI_API_KEY=

# ollama: 모델명과 차원을 위에 명시해야 합니다. 서버에서만 접근합니다.
# 배포 서버에서 127.0.0.1은 사용자의 PC가 아닙니다.
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_OLLAMA_API_KEY=

# ── AI 분석: Vertex AI (기본 제공자) ─────────────────────────────────────────
# 텍스트·URL·이미지 분석은 Vertex AI의 Gemini를 사용합니다. 두 가지 인증 방식 중
# 하나만 설정합니다. 모두 서버 전용이며 브라우저용 접두사를 붙이지 않습니다.
#
# (1) Express 모드: Vertex AI Studio에서 발급한 API 키. 프로젝트 설정이 필요 없습니다.
VERTEX_API_KEY=
#
# (2) 프로젝트 모드: GCP 프로젝트 + 리전 + 서비스 계정 JSON(한 줄) 또는 단기 액세스 토큰.
#     서비스 계정에는 roles/aiplatform.user 권한이 필요합니다.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_SERVICE_ACCOUNT_JSON=
VERTEX_ACCESS_TOKEN=
#
# 사용할 Gemini 모델. 미지정 시 gemini-3.8-flash. gemini-2.5-* 는 thinkingBudget으로 자동 전환됩니다.
VERTEX_MODEL=
# 분석 추론량: low(기본값) 또는 medium. 지연과 품질을 함께 평가한 뒤 조정합니다.
AI_ANALYSIS_THINKING=low

# ── AI 대체 경로 ────────────────────────────────────────────────────────────
# Vertex AI가 인증·할당량·과부하·시간 초과·형식 오류로 실패하면 OPENAI_API_KEY가 있을 때
# OpenAI Responses API로 같은 스키마를 재요청합니다. none 으로 끄면 Vertex만 사용합니다.
AI_FALLBACK_PROVIDER=openai
# 대체 계정이 없으면 일시적 429/503만 최대 1회 재시도합니다. 전체 65초 한도 내에서
# 짧게 기다리며, 일일 한도·권한 오류·안전 차단·시간 초과는 이 경로로 재시도하지 않습니다.
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
#
# 모든 AI 제공자가 실패하면 규칙 기반 탐지 + 공식 규정 검색만으로 결과를 만들고
# 결과에 "규칙 기반 결과 · AI 미사용"과 AI_UNAVAILABLE_RULES_ONLY 안내를 표시합니다.
# off 로 두면 AI 실패를 그대로 오류로 반환합니다 (AI 정확도만 평가할 때 사용).
AI_RULES_FALLBACK=on
